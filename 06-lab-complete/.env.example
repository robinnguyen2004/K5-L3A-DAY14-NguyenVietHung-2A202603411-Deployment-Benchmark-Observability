# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore — KHÔNG commit)
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret: đặt giá trị thật bằng biến môi trường trên nền tảng deploy
AGENT_API_KEY=change-me

# docker compose tự ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
